[Desktop Entry]
Name=Files
GenericName=File Manager
Comment=Access and organize files
Exec=nautilus --new-window %U
Icon=org.gnome.Nautilus
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=org.gnome.Nautilus
Categories=GNOME;GTK;Utility;Core;FileManager;
MimeType=inode/directory;application/x-7z-compressed;application/x-7z-compressed-tar;application/x-bzip;application/x-bzip-compressed-tar;application/x-tar;application/zip;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=nautilus --new-window
